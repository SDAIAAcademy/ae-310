# Copy this file to .env and paste your key. Never commit .env.
OPENROUTER_API_KEY=
# Optional: another provider that serves the OpenAI API shape
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# Optional: other hosted models (a small open-weight chat model, a larger one)
# ADAPT_SMALL_MODEL=liquid/lfm-3-1.7b:free
# ADAPT_LARGE_MODEL=google/gemma-4-31b-it:free
# ADAPT_QUICK=1      fewer rows and training steps: a slow laptop, a quick check
# ADAPT_CACHE=0      send every request to the hosted model again
# ADAPT_STANDIN=1    never call a hosted model: a scripted stand-in answers
# ADAPT_TIER=tiny    the course's own small model (default on a processor); hub = an open-weight model on a notebook GPU
# ADAPT_BASE=Qwen/Qwen3-0.6B   the open-weight model of the hub tier
